{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workflows-starter-template",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-08",

  "observability": {
    "enabled": true
  }, 
  "vars": {
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbxH-Gm7-psKpEYJRl15rFPxAXEWmTiSL158GTG2tsIieqvEgW4ltTxpP3YMSe5926uy/exec",
    "VERIFY_TOKEN": "platina_webhook_secure_2026"
  },
  "workflows": [
    {
      "name": "workflows-starter-template",
      "binding": "WHATSAPP_WORKFLOW",
      "class_name": "WhatsAppWebhookWorkflow"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKFLOW_STATUS",
        "class_name": "WorkflowStatusDO"
      }
    ]
  },
  "upload_source_maps": true
}
