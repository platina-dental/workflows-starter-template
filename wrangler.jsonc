
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "platina-whatsapp-webhook",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-31",

  "observability": {
    "enabled": true
  },

  "vars": {
    "APPS_SCRIPT_URL": "https://script.google.com/macros/s/AKfycbxH-Gm7-psKpEYJRl15rFPxAXEWmTiSL158GTG2tsIieqvEgW4ltTxpP3YMSe5926uy/exec",
},

  "workflows": [
    {
      "name": "platina-whatsapp-forwarder",
      "binding": "WHATSAPP_WORKFLOW",
      "class_name": "WhatsAppWebhookWorkflow",
      "default_retention": {
        "success_retention": "3 days",
        "error_retention": "7 days"
      }
    }
  ],

  "upload_source_maps": true
}
